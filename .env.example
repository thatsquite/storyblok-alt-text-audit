# Storyblok API credentials
STORYBLOK_MANAGEMENT_TOKEN=
STORYBLOK_SPACE_ID=
STORYBLOK_REGION=eu

# Which provider the wrapper uses. Change once ICT confirms the approved one.
VISION_PROVIDER=azure-openai

# The key from ICT. NEVER commit the real value.
VISION_API_KEY=

# Azure OpenAI specifics (only if provider is azure-openai)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=

# Optional: pace between vision calls in ms (default 1200)
ALT_DELAY_MS=1200

# Optional: pace between Storyblok write-back calls in ms (default 250)
WB_DELAY_MS=250
